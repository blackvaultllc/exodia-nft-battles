# ─────────────────────────────────────────────────────────────────────────────
# XOVIA BATTLE GENERATIONS — ENVIRONMENTAL SCHEMA (all values blank)
# Copy to .env for local dev. Never commit .env / .dev.vars / .secrets.env.
# Deploy-time secrets are set with: npx wrangler secret put <NAME>
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (database + auth) ───────────────────────────────────────────────
# Server-side (kept off the client bundle)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Client-side (VITE_ prefix required for browser exposure)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# ── Google Cloud Console OAuth2 (sign-in with Google) ────────────────────────
GOOGLE_OAUTH2_CLIENT_ID=""
GOOGLE_OAUTH2_CLIENT_SECRET=""
VITE_GOOGLE_OAUTH2_CLIENT_ID=""

# ── Server-side AI (OpenAI-compatible gateway; chat support) ─────────────────
XOVIA_AI_API_KEY=""
XOVIA_AI_BASE_URL=""
XOVIA_AI_MODEL=""

# ── Stripe (server-side keys + webhook secret; publishable token is public) ──
STRIPE_SANDBOX_API_KEY=""
STRIPE_LIVE_API_KEY=""
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""
PAYMENTS_LIVE_WEBHOOK_SECRET=""

# ── Client public tokens ─────────────────────────────────────────────────────
VITE_PAYMENTS_CLIENT_TOKEN=""

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
